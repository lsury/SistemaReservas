<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="reservas.presentation.estadisticas.View">
  <grid id="root" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="1100" height="700"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <grid id="filtros" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="8" left="8" bottom="8" right="8"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Filtros de Estadísticas"/>
        <children>

          <component id="lblInicio" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha inicio:"/>
            </properties>
          </component>

          <component id="fechaInicio" class="com.github.lgooddatepicker.components.DatePicker" binding="fechaInicio">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <component id="lblFin" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha fin:"/>
            </properties>
          </component>

          <component id="fechaFin" class="com.github.lgooddatepicker.components.DatePicker" binding="fechaFin">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <component id="consultar" class="javax.swing.JButton" binding="consultar">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Consultar"/>
            </properties>
          </component>

          <component id="pdfRecursos" class="javax.swing.JButton" binding="pdfRecursos">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="PDF Recursos"/>
            </properties>
          </component>

          <component id="pdfActividades" class="javax.swing.JButton" binding="pdfActividades">
            <constraints>
              <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="PDF Actividades"/>
            </properties>
          </component>

        </children>
      </grid>

      <splitpane id="splitRecursos" orientation="0">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <dividerLocation value="520"/>
          <resizeWeight value="0.5"/>
        </properties>
        <border type="etched" title="Recursos reservados por categoría"/>
        <children>

          <scrollpane id="scrollRecursos">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tablaRecursos" class="javax.swing.JTable" binding="tablaRecursos">
                <constraints/>
                <properties>
                  <autoCreateRowSorter value="true"/>
                  <fillsViewportHeight value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>

          <grid id="graficoRecursos" binding="graficoRecursos" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>

        </children>
      </splitpane>

      <splitpane id="splitActividades" orientation="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <dividerLocation value="520"/>
          <resizeWeight value="0.5"/>
        </properties>
        <border type="etched" title="Actividades por semana"/>
        <children>

          <scrollpane id="scrollActividades">
            <constraints>
              <splitpane position="left"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="tablaActividades" class="javax.swing.JTable" binding="tablaActividades">
                <constraints/>
                <properties>
                  <autoCreateRowSorter value="true"/>
                  <fillsViewportHeight value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>

          <grid id="graficoActividades" binding="graficoActividades" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <splitpane position="right"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>

        </children>
      </splitpane>

    </children>
  </grid>
</form>
