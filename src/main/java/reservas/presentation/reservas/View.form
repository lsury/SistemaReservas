<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="reservas.presentation.reservas.View">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="1000" height="650"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="formulario" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="8" left="8" bottom="8" right="8"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Nueva Reserva"/>
        <children>
          <component id="lblIA" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Solicitud con IA:"/>
            </properties>
          </component>
          <scrollpane id="scrollIA">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <preferredSize width="450" height="70"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="solicitudIa" class="javax.swing.JTextArea" binding="solicitudIa">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <rows value="3"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <component id="interpretarIa" class="javax.swing.JButton" binding="interpretarIa">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Interpretar con IA"/>
            </properties>
          </component>
          <component id="lblActividad" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Actividad:"/>
            </properties>
          </component>
          <component id="actividad" class="javax.swing.JTextField" binding="actividad">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblFecha" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha:"/>
            </properties>
          </component>
          <component id="fecha" class="com.github.lgooddatepicker.components.DatePicker" binding="fecha">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblInicio" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora inicio:"/>
            </properties>
          </component>
          <component id="horaInicio" class="javax.swing.JComboBox" binding="horaInicio">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblFin" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora fin:"/>
            </properties>
          </component>
          <component id="horaFin" class="javax.swing.JComboBox" binding="horaFin">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="lblCategorias" class="javax.swing.JLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Categorías requeridas:"/>
            </properties>
          </component>
          <scrollpane id="scrollCategorias">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="2" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <preferredSize width="450" height="85"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="categorias" class="javax.swing.JList" binding="categorias">
                <constraints/>
                <properties>
                  <selectionMode value="2"/>
                  <visibleRowCount value="3"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="botonera" layout-manager="FlowLayout" hgap="8" vgap="5" flow-align="1">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="reservar" class="javax.swing.JButton" binding="reservar">
            <constraints/>
            <properties>
              <text value="Reservar"/>
            </properties>
          </component>
          <component id="cancelarReserva" class="javax.swing.JButton" binding="cancelarReserva">
            <constraints/>
            <properties>
              <text value="Cancelar reserva"/>
            </properties>
          </component>
          <component id="limpiar" class="javax.swing.JButton" binding="limpiar">
            <constraints/>
            <properties>
              <text value="Limpiar"/>
            </properties>
          </component>
          <component id="pdf" class="javax.swing.JButton" binding="pdf">
            <constraints/>
            <properties>
              <text value="Generar PDF"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="scrollTabla">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Mis Reservas"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tabla">
            <constraints/>
            <properties>
              <autoCreateRowSorter value="true"/>
              <fillsViewportHeight value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
