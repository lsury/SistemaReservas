<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="reservas.presentation.clave.View">
  <grid id="root" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="650" height="360"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <grid id="formulario" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="15" left="15" bottom="15" right="15"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Cambiar contraseña"/>
        <children>

          <component id="lblActual" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Contraseña actual:"/>
            </properties>
          </component>

          <component id="claveActual" class="javax.swing.JPasswordField" binding="claveActual">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <component id="lblNueva" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nueva contraseña:"/>
            </properties>
          </component>

          <component id="claveNueva" class="javax.swing.JPasswordField" binding="claveNueva">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <component id="lblConfirmar" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Confirmar contraseña:"/>
            </properties>
          </component>

          <component id="confirmarClave" class="javax.swing.JPasswordField" binding="confirmarClave">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

        </children>
      </grid>

      <grid id="botonera" layout-manager="FlowLayout" hgap="10" vgap="8" flow-align="1">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <component id="cambiar" class="javax.swing.JButton" binding="cambiar">
            <constraints/>
            <properties>
              <text value="Cambiar contraseña"/>
            </properties>
          </component>

          <component id="limpiar" class="javax.swing.JButton" binding="limpiar">
            <constraints/>
            <properties>
              <text value="Limpiar"/>
            </properties>
          </component>

        </children>
      </grid>

    </children>
  </grid>
</form>
